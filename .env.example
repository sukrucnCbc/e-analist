# Bu dosyayı .env adıyla kopyalayıp kendi değerlerinizi girin. .env GitHub'a GİTMEZ.

# Supabase > Project Settings > Database > Connection string > URI
# (Session pooler adresini kullanın; şifreyi [YOUR-PASSWORD] yerine yazın)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Müşteri kodunu geri çözülemez yapan gizli tuz. Bir kere üretin, ASLA değiştirmeyin ve paylaşmayın.
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
HASH_SALT=

# Web sitesi aşamasında kullanılacak (tarayıcıya giden, RLS ile korunan anahtar)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# service_role anahtarı yalnızca sunucu tarafında; tarayıcı koduna ASLA koymayın
SUPABASE_SERVICE_ROLE_KEY=
